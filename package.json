{
  "name": "kamui",
  "version": "1.1.0",
  "description": "Modern CSS component library built on Tailwind CSS 4. Framework-agnostic with zero JavaScript runtime. Works with Vue, React, Astro, Svelte, Angular, and more.",
  "author": "JotnarDev <https://github.com/JotnarDev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JotnarDev/KamUI.git"
  },
  "bugs": {
    "url": "https://github.com/JotnarDev/KamUI/issues"
  },
  "homepage": "https://github.com/JotnarDev/KamUI#readme",
  "keywords": [
    "tailwindcss",
    "tailwind",
    "tailwind-css-4",
    "css",
    "ui",
    "ui-components",
    "components",
    "component-library",
    "design-system",
    "dark-mode",
    "theme",
    "framework-agnostic",
    "css-framework",
    "vue",
    "vue3",
    "react",
    "nextjs",
    "astro",
    "svelte",
    "sveltekit",
    "nuxt",
    "angular",
    "solidjs",
    "qwik"
  ],
  "type": "module",
  "style": "library/index.css",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "library",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./library/index.css",
    "./color": "./library/theme/color.css",
    "./theme": "./library/theme/color.css",
    "./alerts": "./library/components/alerts.css",
    "./avatars": "./library/components/avatars.css",
    "./badges": "./library/components/badges.css",
    "./breadcrumbs": "./library/components/breadcrumbs.css",
    "./buttons": "./library/components/buttons.css",
    "./cards": "./library/components/cards.css",
    "./dropdowns": "./library/components/dropdowns.css",
    "./forms": "./library/components/forms.css",
    "./modals": "./library/components/modals.css",
    "./popovers": "./library/components/popovers.css",
    "./tables": "./library/components/tables.css",
    "./tabs": "./library/components/tabs.css",
    "./typography": "./library/components/typography.css",
    "./pagination": "./library/components/pagination.css",
    "./tooltips": "./library/components/tooltips.css",
    "./progress": "./library/components/progress.css",
    "./spinners": "./library/components/spinners.css",
    "./toasts": "./library/components/toasts.css",
    "./accordion": "./library/components/accordion.css",
    "./dividers": "./library/components/dividers.css",
    "./list-groups": "./library/components/list-groups.css",
    "./stepper": "./library/components/stepper.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build && echo '📦 Library ready to publish!'",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:verbose": "vitest run --reporter=verbose",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,vue,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,vue,css,scss,md}\"",
    "check": "npm run format:check && npm run test",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release:patch": "npm run check && npm version patch -m \"🚀 Release v%s\" && git push --follow-tags",
    "release:minor": "npm run check && npm version minor -m \"🚀 Release v%s\" && git push --follow-tags",
    "release:major": "npm run check && npm version major -m \"🚀 Release v%s\" && git push --follow-tags",
    "release": "npm run release:patch",
    "prepublishOnly": "npm run check && npm run build:lib"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": false
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.24",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 80
  }
}
